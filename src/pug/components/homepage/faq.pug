-
	const faqItems = [
		{
			question: 'Які умови керуючого оператора?',
			answer: 'Керуюча компанія відповідає за повний цикл операційного управління апартаментами: бронювання, сервіс, маркетинг, технічне обслуговування та звітність для власника.',
		},
		{
			question: 'Як власник отримує інформацію про роботу готеля?',
			answer: 'Власнику надається персональний кабінет зі звітами про завантаженість, дохідність та витрати, а також регулярна фінансова аналітика від керуючого оператора.',
		},
		{
			question: 'Чи може власник проживати у своєму номері?',
			answer: 'Так, керуюча компанія надає власникам можливість безоплатного проживання протягом 30 днів на рік, з них:',
			points: ['10 днів у високий сезон;', '20 днів у низький сезон.'],
			open: true,
		},
		{
			question: 'Чи можуть громадяни інших країн придбати апартаменти?',
			answer: 'Так, для іноземних громадян доступне придбання апартаментів за умови дотримання чинного законодавства України та процедур фінансового моніторингу.',
		},
		{
			question: 'Які привілеї мають власники апартаментів?',
			answer: 'Власники отримують пріоритетне бронювання, спеціальні тарифи на сервіси комплексу та доступ до закритої інфраструктури MONTE.',
		},
		{
			question: 'У чому різниця між MONTE Home та MONTE Apartments?',
			answer: 'MONTE Home орієнтований на власне проживання, тоді як MONTE Apartments створений як інвестиційний інструмент із сервісним управлінням та дохідністю.',
		},
		{
			question: 'Чому дивіденди виплачуються від квадратного метра?',
			answer: 'Модель розподілу доходу за квадратним метром забезпечує прозорість, прогнозованість і справедливий розподіл прибутку між усіма власниками.',
		},
		{
			question: 'Чи є гарантії завершення будівництва?',
			answer: 'Проєкт реалізується поетапно з фінансовим контролем, а всі зобов’язання щодо завершення будівництва закріплені в офіційній документації.',
		},
		{
			question: 'Що, якщо я захочу продати апартамент?',
			answer: 'Власник може продати апартамент у будь-який момент, а команда проєкту надає консультаційну підтримку щодо ринкової оцінки та процесу угоди.',
		},
		{
			question: 'Чи є розтермінування?',
			answer: 'Так, доступні індивідуальні програми розтермінування з фіксованим графіком платежів залежно від етапу будівництва.',
		},
		{
			question: 'Чому не купити просто квартиру і самому здавати?',
			answer: 'Сервісна модель MONTE знімає з власника операційне навантаження, мінімізує простої та підвищує стабільність доходу порівняно з самостійною орендою.',
		},
	]

section.faq#faq
	.faq__shell
		h2.faq__title.text-h1.text-black(parallax-text)
			| ЗАПИТАННЯ
			br
			| ТА ВІДПОВІДІ

		.faq__list(data-faq)
			each item in faqItems
				article.faq-item(class=item.open ? 'is-open' : '')
					button.faq-item__trigger(type='button' aria-expanded=item.open ? 'true' : 'false')
						span.faq-item__question.text-subtitle-bold.text-black= item.question
						span.faq-item__icon(aria-hidden='true')

					.faq-item__content
						p.faq-item__answer.text-body.text-black= item.answer
						if item.points
							ul.faq-item__points
								each point in item.points
									li.faq-item__point.text-body.text-black= point
