						<defs>
							<clipPath id="clip0_6124_51494">
								<rect width="100" height="60" fill="white" transform="matrix(-1 0 0 1 100 0)"/>
							</clipPath>
						</defs>
					</svg>
				button(type="button").swiper-buttons-next(data-news-next)
