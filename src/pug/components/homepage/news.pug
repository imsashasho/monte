section.news#news
	
	.news-bg 
		img.news-bg__img(src='/assets/images/news-bg.jpg' alt='Mountain landscape with the resort')
	.news-shell
		.news-title-wrap
			h2.news-title.text-h1.text-black(parallax-text) Новини
			.swiper-buttons
				button(type="button").swiper-buttons-prev(data-news-prev)
