								<rect width="100" height="60" fill="white"/>
							</clipPath>
						</defs>
					</svg>

		.swiper.news-swiper(data-news-swiper)
			ul.swiper-wrapper.news-swiper-wrapper(data-list)
				each slide in newsSlides
					li.swiper-slide.news-swiper-item
						a(href="/news-single.html" aria-label="Link to the single news page").news-swiper-card-link
							.news-swiper-img-block
								img(src=slide.img, alt="Swiper news image")

							.news-swiper-text-block
								p.news-swiper-title.text-subtitle-bold.text-h4=slide.title

								.news-swiper-link-data-block
									span.news-swiper-link.text-button.text-white Переглянути

									.news-swiper-data-block
