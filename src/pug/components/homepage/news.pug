						<g clip-path="url(#clip0_6124_51494)">
							<path d="M-0.205078 26.665V34.1533L50.1943 60.001V49.5615L21.5449 35.001H100V26.001H22.0332L50.1943 11.6895V0.457031L-0.205078 26.665Z" fill="#160F10"/>
