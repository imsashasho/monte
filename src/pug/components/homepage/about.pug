				.about-hero-card__media
					img(src='/assets/images/about-1.jpg', alt='Для тих, хто хоче жити в горах')
				.about-hero-card__overlay
					p.about-hero-card__title.text-h3-mulish.text-body-c(parallax-text) Для тих, хто хоче жити в горах
