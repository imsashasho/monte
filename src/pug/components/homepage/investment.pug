section.investment#investment
	.investment__shell
		.investment__shell-logo-block
			img.investment__shell-logo-sign(src='/assets/images/investment/sign.png' alt='MONTE logo')
			.investment__shell-logo
				.investment__shell-logo-frame
					video.investment__shell-logo-video(autoplay muted loop playsinline)
						source(src='/assets/images/hero.mp4' type='video/mp4')
					.investment__shell-logo-half.investment__shell-logo-half--top
						img(src='/assets/images/investment/investment.png' alt='MONTE logo')
					.investment__shell-logo-half.investment__shell-logo-half--bottom
						img(src='/assets/images/investment/investment.png' alt='' aria-hidden='true')
		h2.investment__title.text-h1.text-black(parallax-text) ІНВЕСТИЦІЙНІ ПРОПОЗИЦІЇ

		.investment__proposals
			.investment-proposal-card
				.investment-proposal-card__media
					img(src='/assets/images/investment/investment-1.jpg' alt='MONTE Home')
					.investment-proposal-card__caption
						.investment-proposal-card__caption-title
							span.investment-proposal-card__name.text-h2.text-white MONTE Home
							span.investment-proposal-card__tag.text-links.text-white (КВАРТИРИ ДЛЯ ЖИТТЯ)
						.investment-proposal-card__body
							p.investment-proposal-card__desc.text-subtitle.text-white Цей формат розроблений для інвесторів, які орієнтовані на капіталізацію активу або преміальне сезонне проживання.
							.investment-proposal-card__stats
								.investment-proposal-card__stat
									span.investment-proposal-card__stat-label.text-button КІЛЬКІСТЬ ЮНІТІВ:
									span.investment-proposal-card__stat-value.text-body 45 лотів у клубному форматі
								.investment-proposal-card__stat
									span.investment-proposal-card__stat-label.text-button ВИСОТА СТЕЛЬ:
									span.investment-proposal-card__stat-value.text-body 3 метри, що є стандартом преміум-класу
								.investment-proposal-card__stat
									span.investment-proposal-card__stat-label.text-button КРАЄВИДИ:
									span.investment-proposal-card__stat-value.text-body Виключно панорамні види на річку Прут та гірські хребти
								.investment-proposal-card__stat
									span.investment-proposal-card__stat-label.text-button ОПАЛЕННЯ:
									span.investment-proposal-card__stat-value.text-body Встановлення власних газових котлів у кожному юніті
								.investment-proposal-card__stat
									span.investment-proposal-card__stat-label.text-button ІНВЕСТИЦІЙНА ПЕРЕВАГА:
									span.investment-proposal-card__stat-value.text-body Висока ліквідність завдяки обмеженій пропозиції та прогнозоване зростання вартості на 18% щороку
				a.investment-proposal-card__button.text-button(href='#construction') 
					span.text-button.text-white Переглянути планування

			.investment-proposal-card
				.investment-proposal-card__media
					img(src='/assets/images/investment/investment-2.jpg' alt='MONTE Apartments')
					.investment-proposal-card__caption
						.investment-proposal-card__caption-title
							span.investment-proposal-card__name.text-h2.text-white MONTE Apartments
							span.investment-proposal-card__tag.text-links.text-white (СЕРВІСНІ АПАРТАМЕНТИ)
						.investment-proposal-card__body
							p.investment-proposal-card__desc.text-subtitle.text-white Готовий інструмент для отримання пасивного доходу від операційної діяльності готелю.
							.investment-proposal-card__stats
								.investment-proposal-card__stat
									span.investment-proposal-card__stat-label.text-button КІЛЬКІСТЬ ЮНІТІВ:
									span.investment-proposal-card__stat-value.text-body 104 апартаменти
								.investment-proposal-card__stat
									span.investment-proposal-card__stat-label.text-button ВИСОТА СТЕЛЬ:
									span.investment-proposal-card__stat-value.text-body Професійний оператор Maestro Hotel Management (рейтинг Forbes NEXT 250)
								.investment-proposal-card__stat
									span.investment-proposal-card__stat-label.text-button КРАЄВИДИ:
									span.investment-proposal-card__stat-value.text-body Орієнтація вікон на лісовий ландшафт Яремче
								.investment-proposal-card__stat
									span.investment-proposal-card__stat-label.text-button ОПАЛЕННЯ:
									span.investment-proposal-card__stat-value.text-body Централізоване (забезпечується власною котельнею комплексу)
								.investment-proposal-card__stat
									span.investment-proposal-card__stat-label.text-button ІНВЕСТИЦІЙНА ПЕРЕВАГА:
									span.investment-proposal-card__stat-value.text-body Прогнозована дохідність 10–11% річних за рахунок цілорічного турпотоку та професійного маркетингу керуючої компанії
				a.investment-proposal-card__button.text-button(href='#construction') 
					span.text-button.text-white Переглянути планування

			.investment-proposal-card
				.investment-proposal-card__media
					img(src='/assets/images/investment/investment-3.jpg' alt='MONTE Parking')
					.investment-proposal-card__caption
						.investment-proposal-card__caption-title
							span.investment-proposal-card__name.text-h2.text-white MONTE Parking
							span.investment-proposal-card__tag.text-links.text-white (ПІДЗЕМНИЙ ПАРКІНГ)
						.investment-proposal-card__body
							p.investment-proposal-card__desc.text-subtitle.text-white Рідкісний та дефіцитний актив у центральній частині курортного міста.
							.investment-proposal-card__stats
								.investment-proposal-card__stat
									span.investment-proposal-card__stat-label.text-button КІЛЬКІСТЬ:
									span.investment-proposal-card__stat-value.text-body 95 машиномісць
								.investment-proposal-card__stat
									span.investment-proposal-card__stat-label.text-button ТИП:
									span.investment-proposal-card__stat-value.text-body Підземний багаторівневий паркінг із прямим доступом до ліфтів обох частин будівлі
								.investment-proposal-card__stat
									span.investment-proposal-card__stat-label.text-button БЕЗПЕКА:
									span.investment-proposal-card__stat-value.text-body На нижньому рівні розташоване власне автономне укриття з властивостями ПРУ площею 354,3 м²
								.investment-proposal-card__stat
									span.investment-proposal-card__stat-label.text-button ІНВЕСТИЦІЙНА ПЕРЕВАГА:
									span.investment-proposal-card__stat-value.text-body Технічний дефіцит паркомісць значно підвищує вартість та ліквідність основної нерухомості (квартири чи апартамента), особливо в умовах дефіциту паркувальних зон у центрі Яремче.
				a.investment-proposal-card__button.text-button(href='#construction') 
					span.text-button.text-white Переглянути планування

		h2.investment__title.investment__title--attractiveness.text-h1.text-black(parallax-text) ІНВЕСТИЦІЙНА ПРИВАБЛИВІСТЬ

		.investment__attractiveness-grid
			p.investment__lead.text-h3-mulish.text-black MONTE — це premium-актив у центрі Яремче, який поєднує капіталізацію нерухомості та стабільний пасивний дохід від туристичного ринку Карпат.
			.investment-stats-group-wrap
				.investment-stats-group
					h3.investment-stats-group__title.text-h3-mulish.text-black Дохідність та капіталізація:
					.investment-stats-group__list
						.investment-stat-item
							span.investment-stat-item__value.text-subtitle-bold.text-black 18% щорічно
							span.investment-stat-item__desc.text-body.text-black Прогнозоване зростання ринкової вартості нерухомості в Яремче.
						.investment-stat-item
							span.investment-stat-item__value.text-subtitle-bold.text-black 20–35%
							span.investment-stat-item__desc.text-body.text-black Очікуваний приріст вартості активу після введення об'єкта в експлуатацію.
						.investment-stat-item
							span.investment-stat-item__value.text-subtitle-bold.text-black 10–11% річних
							span.investment-stat-item__desc.text-body.text-black Розрахункова орієнтовна прибутковість від здачі в оренду під управлінням професійного оператора.

				.investment-stats-group
					h3.investment-stats-group__title.text-h3-mulish.text-black Ринок та турпотік:
					.investment-stats-group__list
						.investment-stat-item
							span.investment-stat-item__value.text-subtitle-bold.text-black 30–40%
							span.investment-stat-item__desc.text-body.text-black Щорічне зростання туристичного потоку в західних регіонах України.
						.investment-stat-item
							span.investment-stat-item__value.text-subtitle-bold.text-black 77–84%
							span.investment-stat-item__desc.text-body.text-black Завантаженість міських готелів об'єкта регіону в пікові періоди.

	.investment__bg
		img.investment__bg-img(src='/assets/images/investment/investment-bg.jpg' alt='Mountain landscape with the resort')
