      .pagination-count
        input.pagination-count__current.text-button(
          type="text" 
          name="pagination-current" 
          value="01" 
          readonly
        )

        
        .pagination-count__max.text-button з 
          span(data-planning-pages-count) ... 
          |  сторінок
          
      button(type="button").pagination__next(data-pagination="next")
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
          <g clip-path="url(#clip0_6124_52212)">
            <path d="M23.0488 11.2002V12.9971L10.9531 19.2012V16.6953L17.8281 13.2012H-1V11.041H17.7129L10.9531 7.60547V4.91016L23.0488 11.2002Z" fill="#F1F1F2"/>
          </g>
          <defs>
            <clipPath id="clip0_6124_52212">
              <rect width="24" height="24" fill="white"/>
            </clipPath>
          </defs>
        </svg>

    button.pagination__more.text-button(type="button" data-more) 
      span Завантажити ще
